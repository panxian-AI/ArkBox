#!/data/data/com.termux/files/usr/bin/bash
# ArkBox QQ 控制命令：start/stop/status/log
# QQ 是官方 LinuxQQ 客户端本体（Xvfb 无头），零注入；扫码走 noVNC 6081
STATE="$HOME/.arkbox"
LOG="$STATE/qq.log"
PID="$STATE/qq.pid"
XVFB_PID="$STATE/xvfb.pid"
VER="0.1.9"
COMPONENT="$STATE/rootfs/opt/snowluma/native/snowluma-linux-arm64.so"

pid_of() {
  if [ -f "$PID" ]; then
    p=$(tr -dc '0-9' < "$PID" 2>/dev/null)
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then echo "$p"; return 0; fi
  fi
  p=$(pgrep -f '/opt/QQ/q[q]' 2>/dev/null | head -n 1)
  if [ -n "$p" ]; then echo "$p" > "$PID" 2>/dev/null; echo "$p"; return 0; fi
  rm -f "$PID"
  return 1
}
running() { pid_of >/dev/null 2>&1; }

# hook 是否真的挂上了：注入成功后载入器会在握手目录里留 mojo.<pid>.control.sock
# （SnowLuma 就是靠扫这个目录发现 QQ 的）。proot 里的 /tmp 没绑宿主，
# 所以宿主侧路径是 rootfs/tmp/
HOOKDIR="$STATE/rootfs/tmp/snowluma-arkbox"
hook_ok() { ls "$HOOKDIR"/mojo.*.control.sock >/dev/null 2>&1; }

# 自愈：把 App 每次开 App 都会刷新到 ~/.arkbox/hook 的载入器递进 rootfs。
# 旧版安装器装的机器（rootfs/opt/qqstack 里没有）不用重跑安装器，这里直接补
fix_hook() {
  [ -f "$STATE/rootfs/opt/qqstack/libslhook.so" ] && return 0
  mkdir -p "$STATE/rootfs/opt/qqstack" 2>/dev/null
  if [ -f "$STATE/hook/libslhook.so" ]; then
    cp -f "$STATE/hook/libslhook.so" "$STATE/hook/libsnowluma_linux_resident_dispatch.so" \
      "$STATE/rootfs/opt/qqstack/" 2>/dev/null && echo "  hook 载入器已从 App 缓存补进 rootfs"
  else
    for u in \
      "https://ghfast.top/https://raw.githubusercontent.com/panxian-AI/ArkBox/main/app/src/main/assets/termux/hook" \
      "https://raw.githubusercontent.com/panxian-AI/ArkBox/main/app/src/main/assets/termux/hook"; do
      curl -fsSL -m 40 -o "$STATE/rootfs/opt/qqstack/libslhook.so" "$u/libslhook.so" 2>/dev/null \
        && curl -fsSL -m 40 -o "$STATE/rootfs/opt/qqstack/libsnowluma_linux_resident_dispatch.so" "$u/libsnowluma_linux_resident_dispatch.so" 2>/dev/null \
        && { echo "  hook 载入器已在线补齐"; return 0; }
    done
    rm -f "$STATE/rootfs/opt/qqstack/libslhook.so" "$STATE/rootfs/opt/qqstack/libsnowluma_linux_resident_dispatch.so" 2>/dev/null
  fi
}

# 自愈：真正的注入组件（libslhook 硬编码找 /opt/snowluma/native/snowluma-linux-arm64.so）。
# 缺了就从 rootfs 里缓存的 SnowLuma 包里补——缺它和缺载入器一样收不了消息
fix_component() {
  [ -s "$COMPONENT" ] && return 0
  local tb="$STATE/rootfs/root/.arkbox/snowluma-lite.tar.gz"
  if [ -s "$tb" ]; then
    mkdir -p "$STATE/rootfs/opt/snowluma/native"
    tar xzf "$tb" -C "$STATE/rootfs/opt/snowluma" ./native/snowluma-linux-arm64.so 2>/dev/null \
      && [ -s "$COMPONENT" ] && { echo "  hook 组件已从 SnowLuma 包补进 /opt/snowluma/native/"; return 0; }
  fi
  echo "! hook 组件缺失（$COMPONENT）且 SnowLuma 缓存包不在，重跑一次「安装 / 更新」"
  return 1
}

# 虚拟屏 + noVNC。独立成函数：QQ 已在跑但 VNC 链挂了时也能单独补起
ensure_vnc() {
  export ARK_BG_LOG="$LOG"
  "$STATE/proot-run.sh" --bg "$XVFB_PID" /bin/bash -c '
  pgrep -x Xvfb >/dev/null || { Xvfb :1 -screen 0 1280x720x16 >/tmp/xvfb.log 2>&1 </dev/null & sleep 2; }
  pgrep -x fluxbox >/dev/null || { fluxbox >/tmp/fluxbox.log 2>&1 </dev/null & }
  pgrep -x x11vnc  >/dev/null || { x11vnc -display :1 -noshm -nopw -forever -shared -rfbport 5900 -localhost >/tmp/x11vnc.log 2>&1 </dev/null & }
  # 不能用 pgrep -f 匹配 websockify：本段脚本的命令行里就有 websockify 这个词，
  # 会自己匹配自己 → websockify 永远不会被拉起，6081 一直拒绝连接就是它。
  # 改用探测端口（bash 内建 /dev/tcp，rootfs 里没有 curl 也能用）
  (exec 3<>"/dev/tcp/127.0.0.1/6081") 2>/dev/null || { websockify --web /usr/share/novnc 127.0.0.1:6081 127.0.0.1:5900 >/tmp/novnc.log 2>&1 </dev/null & }
  '
}

start() {
  if [ ! -f "$STATE/rootfs/opt/QQ/qq" ]; then
    echo "QQ 还没装。先在 App 里点「安装 / 更新」跑完安装器。"
    exit 1
  fi
  # 先保证虚拟屏 + noVNC 在（就算 QQ 已在跑，6081 挂了也要补）
  ensure_vnc
  if running; then
    if hook_ok; then
      echo "QQ 已经在跑（pid $(pid_of)，hook 已握手）"
      echo "  扫码页: http://127.0.0.1:6081/vnc.html"
      return 0
    fi
    # 旧进程没挂 hook（v0.1.4 及以前起的）——自动换成带注入的方式重启。
    # 登录态在 /root/.config/QQ，重启不丢，不用重新扫码
    echo "QQ 在跑（pid $(pid_of)）但没挂 hook，自动换成带注入的方式重启…"
    stop
    sleep 3
  fi
  fix_hook
  fix_component
  if [ ! -f "$STATE/rootfs/opt/qqstack/libslhook.so" ]; then
    echo "! hook 载入器缺失（rootfs/opt/qqstack/libslhook.so），先跑一次「安装 / 更新」"
    echo "  现在仍会启动 QQ，但收消息会失效。"
  fi
  export ARK_BG_LOG="$LOG"
  "$STATE/proot-run.sh" --bg "$XVFB_PID" /bin/bash -c '
  export DISPLAY=:1
  cd /root
  # HOME 必须是 /root：SnowLuma 也要读 /root/.config/QQ/login.db 才能握手
  # LD_PRELOAD 注入必须在登录之前——QQ 崩溃自重启（--relaunch）会丢掉它，
  # 那种情况表现为「界面登录着但机器人不回话」，跑 qq restart 即可，不用重新扫码
  HOME=/root DISPLAY=:1 TZ=Asia/Shanghai \
  LD_PRELOAD=/opt/qqstack/libslhook.so \
  SLHOOK_DELAY_MS=0 SLHOOK_WAIT_WRAPPER=1 \
  SNOWLUMA_HOOK_RUNTIME_DIR=/tmp/snowluma-arkbox \
    /opt/QQ/qq --no-sandbox --disable-gpu --disable-software-rasterizer \
    --disable-gpu-compositing --disable-dev-shm-usage
  '
  echo "QQ 启动中（等 10 秒验证）…"
  sleep 10
  if running; then
    if hook_ok; then
      echo "✓ QQ 已启动（pid $(pid_of)），hook 已握手。"
    elif [ -f "$STATE/rootfs/opt/qqstack/libslhook.so" ]; then
      echo "✓ QQ 已启动（pid $(pid_of)），载入器已挂（握手要等 SnowLuma 侧跑起来：box start）。"
    else
      echo "✓ QQ 已启动（pid $(pid_of)），⚠️ 没带 hook（载入器缺失），收消息会失效。"
    fi
    echo "  扫码页: http://127.0.0.1:6081/vnc.html（打不开就跑: qq vnc）"
    echo "  登录态在 /root/.config/QQ，重启不用重新扫码"
  else
    echo "✗ QQ 没起来，最近日志："
    tail -n 15 "$LOG" 2>/dev/null
  fi
}

# 单独修 VNC 链（6081 打不开时用，不用动 QQ）
vnc() {
  echo "qq 脚本版本 $VER"
  ensure_vnc
  sleep 4
  local code
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:6081/vnc.html" 2>/dev/null || echo 000)
  if [ "$code" != "000" ]; then
    echo "✓ 6081 已通（HTTP $code）: http://127.0.0.1:6081/vnc.html"
    return 0
  fi
  echo "✗ 6081 还是不通，逐项自检："
  "$STATE/proot-run.sh" /bin/bash -c '
  echo "-- 进程"
  for n in Xvfb fluxbox x11vnc; do pgrep -x "$n" >/dev/null && echo "  $n: 在跑" || echo "  $n: 没跑"; done
  echo "-- 端口（proot 内视角）"
  for p in 5900 6081; do (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && echo "  $p: 通" || echo "  $p: 不通"; done
  echo "-- 组件"
  command -v Xvfb >/dev/null && echo "  Xvfb: 有" || echo "  Xvfb: 缺失"
  command -v x11vnc >/dev/null && echo "  x11vnc: 有" || echo "  x11vnc: 缺失"
  command -v websockify >/dev/null && echo "  websockify: 有" || echo "  websockify: 缺失"
  [ -f /usr/share/novnc/vnc.html ] && echo "  noVNC 页面: 有" || echo "  noVNC 页面: 缺失（/usr/share/novnc/vnc.html）"
  echo "-- 最近日志"
  for f in /tmp/xvfb.log /tmp/x11vnc.log /tmp/novnc.log /tmp/fluxbox.log; do
    echo " [$f]"; tail -n 5 "$f" 2>/dev/null || echo "  （无）"
  done
  '
}

stop() {
  p=$(pid_of 2>/dev/null) && kill "$p" 2>/dev/null
  sleep 2
  "$STATE/proot-run.sh" /bin/bash -c 'pkill -f "/opt/QQ/q[q]" 2>/dev/null || true' || true
  rm -f "$PID"
  # 清掉上次注入留下的握手 socket，免得下次误判成「已握手」
  rm -f "$HOOKDIR"/mojo.*.control.sock 2>/dev/null
  echo "QQ 已停止"
}

status() {
  echo "qq 脚本版本 $VER"
  if running; then
    echo "QQ: 运行中（pid $(pid_of)）"
  else
    echo "QQ: 未运行"
  fi
  if [ ! -s "$COMPONENT" ]; then
    echo "  hook 组件: 缺失（/opt/snowluma/native/snowluma-linux-arm64.so，重跑安装器或 qq restart 自动补）"
  fi
  if [ ! -f "$STATE/rootfs/opt/qqstack/libslhook.so" ]; then
    echo "  hook 载入器: 缺失（跑一次「安装 / 更新」，否则收消息失效）"
  elif hook_ok; then
    echo "  hook: 已握手（$(ls "$HOOKDIR"/mojo.*.control.sock 2>/dev/null | head -1 | xargs -r basename)）"
  else
    echo "  hook: 没握手（qq restart 换成带注入的方式重启）"
  fi
  echo "  提示: SnowLuma 网页里那个「加载」按钮在 ArkBox 里点不了——它是官方注入器（ptrace 写内存），proot 下必报 component loading failed；hook 由 LD_PRELOAD 自动接上，不用点它"
  # 顺带报 OneBot / WebUI / noVNC 状态，一眼看全链路
  for p in 3000 3001 5099 6081; do
    code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$p/" 2>/dev/null || echo 000)
    [ "$code" != "000" ] && echo "  端口 $p: 通($code)" || echo "  端口 $p: 不通"
  done
  echo "  扫码页: http://127.0.0.1:6081/vnc.html"
}

log() { tail -n "${2:-50}" "$LOG" 2>/dev/null || echo "还没有日志"; }

case "${1:-status}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  vnc)     vnc ;;
  log)     shift; log "$@" ;;
  *) echo "用法: qq start|stop|restart|status|vnc|log [行数]"; exit 1 ;;
esac
