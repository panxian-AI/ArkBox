#!/data/data/com.termux/files/usr/bin/bash
# ArkBox 的 AstrBot 控制命令：start/stop/status/log/creds/resetpw/shell/run
#
# 这个文件由 App 在「安装 / 更新」一开始就预置好（不等安装跑完），
# 所以任何时候 astr status 都能回答两件事：装到哪一步了 / AstrBot 跑没跑。
STATE="$HOME/.arkbox"
ROOTFS="$STATE/rootfs"
LOG="$STATE/astr.log"
PID="$STATE/astr.pid"
MAIN="$ROOTFS/root/AstrBot/main.py"
VER="0.1.10"

# pidfile 不可信（可能为空/丢失）：先验 pidfile，不行就按命令行特征兜底找进程，
# 找到的话顺手把 pid 写回 pidfile，避免起出第二个实例撞 6185 端口
pid_of() {
  if [ -f "$PID" ]; then
    p=$(tr -dc '0-9' < "$PID" 2>/dev/null)
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then echo "$p"; return 0; fi
  fi
  p=$(pgrep -f 'python main\.py' 2>/dev/null | head -n 1)
  if [ -n "$p" ]; then echo "$p" > "$PID" 2>/dev/null; echo "$p"; return 0; fi
  rm -f "$PID"
  return 1
}
running() { pid_of >/dev/null 2>&1; }
installed() { [ -f "$MAIN" ]; }

# 读安装器写的 state 文件（~/.arkbox/state），报告安装进度/失败原因
install_state() {
  [ -f "$STATE/state" ] || return 0
  st=""; step=""; total=""; desc=""; err=""
  while IFS='=' read -r k v; do
    case "$k" in
      status) st="$v" ;;
      step) step="$v" ;;
      total) total="$v" ;;
      desc) desc="$v" ;;
      err) err="$v" ;;
    esac
  done < "$STATE/state"
  case "$st" in
    running) echo "安装进行中：第 ${step:-?}/${total:-9} 步 · ${desc:-…}（装完才能 start）" ;;
    failed)  echo "安装失败（第 $step 步：$desc）：${err:-详情看 astr log}"
             echo "修复后重新点「安装 / 更新」，会从断掉的地方接着装" ;;
    done)    echo "安装完成 ✓" ;;
  esac
}

start() {
  if ! installed; then
    echo "AstrBot 还没装好（$MAIN 不存在）。先在 App 里点「安装 / 更新」。"
    exit 1
  fi
  if running; then echo "已经在跑了（pid $(pid_of)）"; return 0; fi
  : > "$LOG"
  # 由 App 起平级 proot 进程（外层 Termux 环境已经是 proot，不能再套一层）
  ARK_BG_LOG="$LOG" "$STATE/proot-run.sh" --bg "$PID" /bin/bash -c \
    'cd /root/AstrBot && exec ./.venv/bin/python main.py'
  echo "已启动（pid $(cat "$PID" 2>/dev/null)），日志：$LOG"
  sleep 3
  tail -n 12 "$LOG" 2>/dev/null || true
}

stop() {
  p=$(pid_of 2>/dev/null || true)
  if [ -z "$p" ]; then echo "没在跑"; rm -f "$PID"; return 0; fi
  kill "$p" 2>/dev/null || true
  sleep 1
  kill -9 "$p" 2>/dev/null || true
  pkill -f 'python main\.py' 2>/dev/null || true
  rm -f "$PID"
  echo "已停止"
}

status() {
  echo "astr 脚本版本 $VER"
  install_state
  if installed; then
    echo "AstrBot 源码就位：/root/AstrBot"
  else
    echo "AstrBot 未安装（先点 App 里的「安装 / 更新」）"
  fi
  running && echo "进程在跑（pid $(pid_of)）" || echo "进程没在跑"
  code=$(curl -s -o /dev/null -m 4 -w '%{http_code}' http://127.0.0.1:6185/ 2>/dev/null || echo 000)
  echo "面板 127.0.0.1:6185 → HTTP $code"
  [ -f "$LOG" ] && echo "日志最后一行：$(tail -n 1 "$LOG" 2>/dev/null)"
}

# 一条命令回答「为什么指令不回、消息不回」：
#   1) 端口/进程有没有起来   2) OneBot 3001 通不通
#   3) AstrBot 配置里白名单/管理员到底长什么样   4) 日志里是不是白名单把事件丢了
diag() {
  echo "astr 脚本版本 $VER"
  running && echo "AstrBot: 运行中（pid $(pid_of)）" || echo "AstrBot: 没在跑（astr start）"
  code=$(curl -s -o /dev/null -m 4 -w '%{http_code}' http://127.0.0.1:6185/ 2>/dev/null || echo 000)
  echo "面板 6185 → HTTP $code"
  for p in 3000 3001 6199; do
    c=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$p/" 2>/dev/null || echo 000)
    case "$p:$c" in
      3000:*|3001:*) [ "$c" != "000" ] && echo "OneBot $p: 通($c)" || echo "OneBot $p: 不通（QQ 没登录或 hook 没接上）" ;;
      6199:*) [ "$c" != "000" ] && echo "反向WS 6199: 通($c)——AstrBot 在等 SnowLuma 来连" || echo "反向WS 6199: 不通（AstrBot 没在跑，或 aiocqhttp 平台没启用）" ;;
    esac
  done
  # 配置摘要：白名单是否开启、里面到底有什么、管理员是谁、平台怎么连的
  mkdir -p "$ROOTFS/root/.arkbox" 2>/dev/null
  cat > "$ROOTFS/root/.arkbox/diag.py" <<'PY'
import json, os
p = "/root/AstrBot/data/cmd_config.json"
print("-- 配置", p)
if not os.path.exists(p):
    print("  ! 配置文件不存在（AstrBot 还没初始化，先 astr start 一次）")
else:
    c = json.load(open(p, encoding="utf-8"))
    ps = c.get("platform_settings", {}) or {}
    print("  enable_id_white_list :", ps.get("enable_id_white_list"))
    wl = ps.get("id_whitelist") or []
    print("  id_whitelist         :", wl if wl else "（空 = 不检查）")
    print("  wl_ignore_admin_group/friend:",
          ps.get("wl_ignore_admin_on_group"), "/", ps.get("wl_ignore_admin_on_friend"))
    print("  id_blacklist         :", ps.get("id_blacklist") or "（空）")
    print("  admins_id            :", c.get("admins_id") or "（空）")
    for i, pf in enumerate(c.get("platform") or []):
        t = pf.get("type")
        keys = {k: pf.get(k) for k in ("ws_reverse_host", "ws_reverse_port", "ws_reverse_url", "host", "port") if k in pf}
        print(f"  platform[{i}]: {t} {keys}")
PY
  "$STATE/proot-run.sh" /usr/bin/python3 /root/.arkbox/diag.py 2>&1 | sed 's/^/  /'
  echo "-- 日志里的关键行（最近 400 行里找）"
  if [ -f "$LOG" ]; then
    grep -aiE "allowlist|event propagation|aiocqhttp|websocket|已连接|连接失败|CQHttp|ws " "$LOG" 2>/dev/null | tail -n 12 | sed 's/^/  /'
    hit=$(grep -ac "allowlist" "$LOG" 2>/dev/null || echo 0)
    echo "  allowlist 命中次数：$hit"
    [ "${hit:-0}" -gt 0 ] && echo "  → 就是白名单把事件丢了：把日志里那个 Session ID 原样加进白名单（或先关掉白名单）"
  else
    echo "  还没有日志（astr start 一次）"
  fi
  echo "-- 白名单匹配规则"
  echo "  私聊 UMO 形如：aiocqhttp:FriendMessage:<QQ号>"
  echo "  群聊 UMO 形如：aiocqhttp:GroupMessage:<群号>（也可以直接填群号）"
  echo "  只填纯 QQ 号匹配不上私聊；白名单命中前 /sid 也会被丢掉（鸡生蛋）"
}

# 一键打通 SnowLuma → AstrBot。
# 真相：AstrBot 的 aiocqhttp 适配器只会「反向 WS」——它自己当服务端听 6199，
# 等 OneBot 实现（SnowLuma）主动来连。它没有「连 ws://127.0.0.1:3001」的正向模式。
# 所以必须在 SnowLuma 的 onebot_<QQ号>.json 里加一个 WS 客户端指向 ws://127.0.0.1:6199/ws，
# 并把两边的 token 对齐（取 SnowLuma wsServers[0] 的 accessToken 作为共享 token）。
link() {
  if ! installed; then echo "AstrBot 还没装好。"; exit 1; fi
  conf=$(ls "$STATE"/rootfs/opt/snowluma/config/onebot_*.json 2>/dev/null | head -1)
  if [ -z "$conf" ]; then
    echo "✗ SnowLuma 还没生成 onebot 配置（QQ 没登录）。先 qq start → noVNC 扫码，再跑 astr link。"
    exit 1
  fi
  echo "OneBot 配置：${conf#$STATE/rootfs}"
  mkdir -p "$ROOTFS/root/.arkbox" 2>/dev/null
  cat > "$ROOTFS/root/.arkbox/link.py" <<'PY'
import json, glob, sys

# ---- SnowLuma 侧：加反向 WS 客户端（SnowLuma 主动连 AstrBot 的 6199）----
cands = sorted(glob.glob("/opt/snowluma/config/onebot_*.json"))
if not cands:
    print("! 没找到 /opt/snowluma/config/onebot_*.json（QQ 未登录？）"); sys.exit(1)
ob_path = cands[0]
ob = json.load(open(ob_path, encoding="utf-8"))

def find_list(o, names):
    net = o.get("network")
    if isinstance(net, dict):
        for n in names:
            if isinstance(net.get(n), list):
                return net[n], "network." + n
    for n in names:
        if isinstance(o.get(n), list):
            return o[n], n
    return None, None

servers, _ = find_list(ob, ("websocketServers", "wsServers"))
tok = ""
if servers:
    tok = servers[0].get("accessToken") or servers[0].get("token") or ""
clients, where = find_list(ob, ("wsClients", "websocketClients"))
URL = "ws://127.0.0.1:6199/ws"
entry = {
    "name": "astrbot",
    "enabled": True, "enable": True,
    "url": URL, "uri": URL,
    "role": "Universal",
    "accessToken": tok, "token": tok,
    "messagePostFormat": "array", "messageFormat": "array",
    "reconnectInterval": 5000, "reconnectIntervalMs": 5000,
    "reportSelfMessage": False, "debug": False,
}
if clients is None:
    ob["wsClients"] = [entry]; where = "wsClients（新建）"
else:
    clients[:] = [c for c in clients if c.get("name") != "astrbot"]
    clients.append(entry)
with open(ob_path, "w", encoding="utf-8") as f:
    json.dump(ob, f, ensure_ascii=False, indent=2)
print(f"✓ SnowLuma：{where} 已加客户端 → {URL}（token {'已对齐' if tok else '为空'}）")

# ---- AstrBot 侧：反向 WS 服务端 127.0.0.1:6199，token 对齐 ----
p = "/root/AstrBot/data/cmd_config.json"
c = json.load(open(p, encoding="utf-8"))
hit = False
for pf in (c.get("platform") or []):
    if pf.get("type") == "aiocqhttp":
        pf["enable"] = True
        pf["ws_reverse_host"] = "127.0.0.1"
        pf["ws_reverse_port"] = 6199
        pf["ws_reverse_token"] = tok
        hit = True
        print(f"✓ AstrBot platform[{pf.get('id','')}]：反向 WS 监听 127.0.0.1:6199（token {'已对齐' if tok else '为空'}）")
if not hit:
    print("! AstrBot 里还没有 aiocqhttp 平台——去面板「消息平台」新增一个（选 aiocqhttp），保存后再跑一次 astr link")
with open(p, "w", encoding="utf-8") as f:
    json.dump(c, f, ensure_ascii=False, indent=2)
PY
  if ! "$STATE/proot-run.sh" /usr/bin/python3 /root/.arkbox/link.py 2>&1; then
    echo "link 失败，把上面的报错原样发我。"; return 1
  fi
  echo "-- 重启 SnowLuma → AstrBot 让配置生效…"
  "$STATE/box" restart 2>/dev/null | tail -n 3 || echo "  （box restart 没跑成，手动执行：box restart）"
  stop >/dev/null 2>&1; sleep 1; start >/dev/null 2>&1
  echo "完成。自检："
  echo "  box log 里找：WS-Client connected ws://127.0.0.1:6199/ws"
  echo "  astr log 里找：aiocqhttp(OneBot v11) 适配器已连接。"
  echo "两行都有 → 私聊发 /sid 试；没回再跑 astr diag 把输出发我。"
}

# 白名单直接改配置文件（不用在面板里翻）：wl show/off/on/add <UMO>/del <UMO>/clear
# 改完自动重启一次，立刻生效
wl() {
  sub="${1:-show}"; arg="${2:-}"
  if ! installed; then echo "AstrBot 还没装好。"; exit 1; fi
  mkdir -p "$ROOTFS/root/.arkbox" 2>/dev/null
  cat > "$ROOTFS/root/.arkbox/wl.py" <<'PY'
import json, sys
p = "/root/AstrBot/data/cmd_config.json"
sub = sys.argv[1] if len(sys.argv) > 1 else "show"
arg = sys.argv[2] if len(sys.argv) > 2 else ""
try:
    c = json.load(open(p, encoding="utf-8"))
except Exception as e:
    print("读取配置失败:", e); sys.exit(1)
ps = c.setdefault("platform_settings", {})
wl = ps.setdefault("id_whitelist", [])
if sub == "show":
    print("enable_id_white_list =", ps.get("enable_id_white_list"))
    print("id_whitelist =", wl if wl else "（空 = 不检查）")
    print("admins_id =", c.get("admins_id") or "（空）")
    print("wl_ignore_admin_on_group/friend =",
          ps.get("wl_ignore_admin_on_group"), "/", ps.get("wl_ignore_admin_on_friend"))
    sys.exit(0)
if sub == "off":
    ps["enable_id_white_list"] = False
elif sub == "on":
    ps["enable_id_white_list"] = True
elif sub == "add":
    if not arg:
        print("要给出 UMO，例如 aiocqhttp:FriendMessage:123456789"); sys.exit(2)
    if arg not in wl:
        wl.append(arg)
elif sub == "del":
    if arg in wl:
        wl.remove(arg)
elif sub == "clear":
    wl.clear()
else:
    print("未知子命令:", sub); sys.exit(2)
with open(p, "w", encoding="utf-8") as f:
    json.dump(c, f, ensure_ascii=False, indent=2)
print("已写入: enable_id_white_list =", ps.get("enable_id_white_list"), "| id_whitelist =", wl)
PY
  out=$("$STATE/proot-run.sh" /usr/bin/python3 /root/.arkbox/wl.py "$sub" "$arg" 2>&1)
  echo "$out"
  case "$sub" in
    off|on|add|del|clear)
      case "$out" in
        已写入*) echo "重启 AstrBot 让配置生效…"; stop >/dev/null 2>&1; sleep 1; start ;;
      esac
      ;;
  esac
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  diag) diag ;;
  link) link ;;
  wl) shift; wl "$@" ;;
  log) tail -n "${2:-80}" "$LOG" 2>/dev/null || echo "还没日志" ;;
  creds) "$STATE/proot-run.sh" /usr/bin/python3 /root/.arkbox/creds.py ;;
  setpw|resetpw)
    pw="${2:-}"
    if [ -z "$pw" ]; then
      # 自动生成：固定前缀保证一定满足 AstrBot 的复杂度要求（大写+小写+数字）
      pw="Arkb0t-$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 6)"
    fi
    case "$pw" in
      *[A-Z]*) : ;; *) echo "✗ 密码要含大写字母"; exit 2 ;;
    esac
    case "$pw" in
      *[a-z]*) : ;; *) echo "✗ 密码要含小写字母"; exit 2 ;;
    esac
    case "$pw" in
      *[0-9]*) : ;; *) echo "✗ 密码要含数字"; exit 2 ;;
    esac
    if [ "${#pw}" -lt 8 ]; then echo "✗ 至少 8 位"; exit 2; fi
    was_running=0; running && was_running=1
    stop >/dev/null 2>&1
    echo "改写面板配置（pbkdf2 计算要几秒）…"
    out=$("$STATE/proot-run.sh" /usr/bin/python3 /root/.arkbox/setpw.py "$pw")
    case "$out" in
      OK=1*)
        echo "$out"
        echo "$pw" > "$STATE/panel.pw"; chmod 600 "$STATE/panel.pw" 2>/dev/null
        [ "$was_running" = 1 ] && start
        echo "✓ 面板密码已重置（App 的「账号密码」卡也会显示）"
        ;;
      *)
        echo "$out"; echo "✗ 改配置失败"
        [ "$was_running" = 1 ] && start
        exit 1
        ;;
    esac
    ;;
  shell) echo "交互 shell 不可用（App 不是终端）。用：astr run '命令'，例如 astr run 'ls /root'" ;;
  run) shift; "$STATE/proot-run.sh" /bin/bash -c "$*" ;;
  *) echo "用法: astr {start|stop|restart|status|diag|link|wl show|wl off|wl on|wl add <UMO>|wl del <UMO>|wl clear|log|creds|resetpw|shell|run}" ;;
esac
